    {
      "name": "Environmental Data",
      "item": [
        {
          "name": "Create Adapter",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"sensorType\": \"sensorB\",\r\n  \"mapping\": {\r\n    \"device_id\": \"meta.id\",\r\n    \"ph\": \"phwater_ong\",\r\n    \"temperature\": \"temp_sensor\",\r\n    \"turbidity\": \"turb_val\",\r\n    \"timestamp\": \"time\"\r\n  }\r\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/adapters",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "adapters"]
            }
          }
        },
        {
          "name": "Process Sensor Data",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"sensorType\": \"sensorB\",\r\n  \"payload\": {\r\n    \"meta\": { \"id\": \"sensor_001\" },\r\n    \"phwater_ong\": 5.2,\r\n    \"temp_sensor\": 26.5,\r\n    \"turb_val\": 120,\r\n    \"time\": \"2026-04-19T13:00:00Z\"\r\n  }\r\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/environmental-data",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "environmental-data"]
            }
          }
        },
        {
          "name": "Get Filtered Data",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8080/api/v1/environmental-data?phMin=5.0",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "environmental-data"],
              "query": [
                { "key": "phMin", "value": "5.0" }
              ]
            }
          }
        },
        {
          "name": "Get Aggregated Data",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8080/api/v1/environmental-data/aggregate",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "environmental-data", "aggregate"]
            }
          }
        }
      ]
    }
  ]

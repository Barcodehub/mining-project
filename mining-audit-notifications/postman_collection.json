            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"status\": \"VALIDADO\",\r\n  \"validatorId\": 2\r\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/reports/1/status",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "reports", "1", "status"]
            }
          }
        }
      ]
    },

{
  "info": {
    "name": "Mining Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Posts",
      "item": [
        {
          "name": "Create Forum Post",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"title\": \"Discusion sobre zonas\",\r\n  \"content\": \"Alguien sabe sobre...\",\r\n  \"userId\": 1,\r\n  \"type\": \"FORUM\"\r\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/posts",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "posts"]
            }
          }
        },
        {
          "name": "Create Report Post",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"title\": \"Mineria encontrada en x zona\",\r\n  \"content\": \"Reporto actividad...\",\r\n  \"userId\": 1,\r\n  \"type\": \"REPORT\",\r\n  \"latitude\": 7.89,\r\n  \"longitude\": -72.50,\r\n  \"images\": [\r\n    { \"imageUrl\": \"http://s3.aws/img1.png\" }\r\n  ]\r\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/v1/posts",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "posts"]
            }
          }
        },
        {
          "name": "Get All Posts (Paginated)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8080/api/v1/posts?page=0&size=10",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "posts"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Post Comments",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8080/api/v1/posts/1/comments",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "posts", "1", "comments"]
            }
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "Filter Reports",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:8080/api/v1/reports?status=SIN_VALIDAR",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "v1", "reports"],
              "query": [
                { "key": "status", "value": "SIN_VALIDAR" }
              ]
            }
          }
        },
        {
          "name": "Get Report By Id",
          "request": {
            "method": "GET",
            "url": {

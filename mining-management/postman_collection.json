    {
      "name": "Environmental Data",
      "item": [
        {
          "name": "Create Adapter",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"sensorType\": \"multi_parameter_sensor\",\r\n  \"mapping\": {\r\n    \"device_id\": \"deviceId\",\r\n    \"lat\": \"latitude\",\r\n    \"lng\": \"longitude\",\r\n    \"cluster_id\": \"clusterId\",\r\n    \"ph\": \"ph\",\r\n    \"hg_dissolved\": \"hg_dissolved\",\r\n    \"hg_total\": \"hg_total\",\r\n    \"hg_sediment\": \"hg_sediment\",\r\n    \"methylmercury\": \"methylmercury\",\r\n    \"hg_fish\": \"hg_fish\",\r\n    \"turbidity\": \"turbidity\",\r\n    \"temperature\": \"temperature\",\r\n    \"redox\": \"redox\",\r\n    \"dissolved_oxygen\": \"dissolved_oxygen\",\r\n    \"organic_carbon\": \"organic_carbon\",\r\n    \"timestamp\": \"timestamp\"\r\n  }\r\n}"
            },
            "url": {
              "raw": "http://localhost:8082/api/v1/adapters",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8082",
              "path": ["api", "v1", "adapters"]
            }
          }
        },
